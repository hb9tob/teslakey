mainmenu "teslakey"

config TESLAKEY_VIN
    string "VIN du vehicule (17 caracteres)"
    default "5YJ3E1EA7JF000000"
    help
      Le VIN sert a deux choses : deriver le nom BLE recherche
      (SHA1 du VIN) et personnaliser les signatures. Il doit faire
      exactement 17 caracteres.

module = TESLAKEY
module-str = teslakey
source "subsys/logging/Kconfig.template.log_config"

source "Kconfig.zephyr"
